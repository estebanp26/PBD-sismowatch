# ==========================================
# SismoWatch - Variables de Entorno (.env.example)
# ==========================================

# Base de Datos PostgreSQL
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Contraseñas de Roles de Mínimo Privilegio
SISMO_INGEST_PASSWORD=ingest_secret_pass_2026
SISMO_ETL_PASSWORD=etl_secret_pass_2026
SISMO_APP_PASSWORD=app_readonly_pass_2026

# Almacenamiento S3 / MinIO (Lakehouse Medallion)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_pass_2026
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=sismowatch-lake
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_secret_pass_2026
AWS_DEFAULT_REGION=us-east-1

# Apache Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2-python3.11
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY_HERE
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW_ADMIN_USER=sismo_admin
AIRFLOW_ADMIN_PASSWORD=airflow_secure_admin_2026
AIRFLOW_ADMIN_EMAIL=admin@sismowatch.internal
AIRFLOW_PORT=8080

# API Backend (FastAPI)
API_PORT=8000
API_HOST=0.0.0.0
JWT_SECRET_KEY=sismowatch_jwt_super_secret_key_2026_change_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Credenciales de Plataforma Sembradas
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePass2026!
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=ViewerSecurePass2026!

# Inteligencia Artificial (Ollama / Qwen2.5)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Frontend Web
WEB_PORT=3000
VITE_API_URL=http://localhost:8000

# Fuente Externa USGS (API Pública de Monitoreo Sísmico)
USGS_REALTIME_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
USGS_QUERY_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
